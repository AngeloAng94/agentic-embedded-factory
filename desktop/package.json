{
  "name": "embedfactory-desktop",
  "version": "1.0.0",
  "description": "EmbedFactory - Embedded Firmware AI Factory (Desktop)",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:server": "node server/index.js",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:win": "vite build && electron-builder --win",
    "build:all": "vite build && electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.embedfactory.desktop",
    "productName": "EmbedFactory",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "server/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "electron-is-dev": "^2.0.0",
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
